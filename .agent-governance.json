{
  "version": 4,
  "project": {
    "name": "Project Agent Toolkit"
  },
  "entrypoints": [
    "AGENTS.md",
    ".github/copilot-instructions.md"
  ],
  "adapters": {
    "outputs": [
      {
        "kind": "agents",
        "path": "AGENTS.md"
      },
      {
        "kind": "copilot",
        "path": ".github/copilot-instructions.md"
      }
    ]
  },
  "authorities": [
    {
      "id": "architecture",
      "path": "docs/ARCHITECTURE.md",
      "purpose": "System boundaries and design decisions",
      "always": false
    },
    {
      "id": "rules",
      "path": "RULES.md",
      "purpose": "Non-negotiable repository constraints",
      "always": true
    },
    {
      "id": "workflow",
      "path": "docs/WORKFLOW.md",
      "purpose": "How work is planned, changed, verified, and handed off",
      "always": true
    },
    {
      "id": "state",
      "path": "PROGRESS.md",
      "purpose": "Current objective, verified state, and next action",
      "always": false
    }
  ],
  "routes": [
    {
      "id": "architecture",
      "terms": [
        "architecture",
        "design",
        "public api",
        "schema",
        "protocol",
        "dependency"
      ],
      "paths": [
        "plugins/project-agent-toolkit/scripts/governance.py",
        "plugins/project-agent-toolkit/assets/templates/**"
      ],
      "read": [
        "architecture",
        "rules",
        "workflow",
        "state"
      ],
      "validation": [
        "focused"
      ]
    },
    {
      "id": "implementation",
      "terms": [
        "implement",
        "change",
        "fix",
        "build",
        "refactor"
      ],
      "paths": [
        "plugins/project-agent-toolkit/skills/**",
        "plugins/project-agent-toolkit/scripts/**",
        "scripts/**",
        "tests/**"
      ],
      "read": [
        "rules",
        "workflow",
        "state"
      ],
      "validation": [
        "focused"
      ]
    },
    {
      "id": "visual",
      "terms": [
        "ui",
        "visual",
        "render",
        "drawing",
        "modeling",
        "3d model",
        "character model",
        "mesh",
        "animation",
        "vfx",
        "layout",
        "scene",
        "map",
        "terrain",
        "css",
        "style",
        "font",
        "icon",
        "responsive",
        "material",
        "texture",
        "shader",
        "lighting",
        "camera",
        "art"
      ],
      "paths": [],
      "read": [
        "architecture",
        "rules",
        "workflow",
        "state"
      ],
      "validation": [
        "visual"
      ]
    },
    {
      "id": "default",
      "terms": [],
      "paths": [
        "**/*"
      ],
      "read": [
        "rules",
        "workflow"
      ],
      "validation": [
        "fast"
      ]
    }
  ],
  "route_tests": [
    {
      "id": "architecture-by-task",
      "task": "change the governance schema architecture",
      "paths": [],
      "expect_routes": [
        "architecture",
        "implementation"
      ],
      "expect_documents": [
        "RULES.md",
        "docs/WORKFLOW.md",
        "docs/ARCHITECTURE.md",
        "PROGRESS.md"
      ],
      "expect_validation_profiles": [
        "focused"
      ]
    },
    {
      "id": "implementation-by-path",
      "task": "",
      "paths": [
        "tests/test_governance.py"
      ],
      "expect_routes": [
        "implementation"
      ],
      "expect_documents": [
        "RULES.md",
        "docs/WORKFLOW.md",
        "PROGRESS.md"
      ],
      "expect_validation_profiles": [
        "focused"
      ]
    },
    {
      "id": "visual-route",
      "task": "inspect UI layout",
      "paths": [],
      "expect_routes": [
        "visual"
      ],
      "expect_documents": [
        "RULES.md",
        "docs/WORKFLOW.md",
        "docs/ARCHITECTURE.md",
        "PROGRESS.md"
      ],
      "expect_validation_profiles": [
        "visual"
      ]
    },
    {
      "id": "default-route",
      "task": "summarize current policy",
      "paths": [],
      "expect_routes": [
        "default"
      ],
      "expect_documents": [
        "RULES.md",
        "docs/WORKFLOW.md"
      ],
      "expect_validation_profiles": [
        "fast"
      ]
    }
  ],
  "rules": [
    {
      "id": "project-neutral",
      "authority": "rules",
      "source": "RULES.md#project-agent-toolkit-rules",
      "guard": "fast"
    },
    {
      "id": "quality-before-completion",
      "authority": "rules",
      "source": "RULES.md#project-agent-toolkit-rules",
      "guard": "focused"
    },
    {
      "id": "release-ingestion",
      "authority": "rules",
      "source": "RULES.md#project-agent-toolkit-rules",
      "guard": "release"
    },
    {
      "id": "mcp-development-opt-in",
      "authority": "rules",
      "source": "RULES.md#project-agent-toolkit-rules",
      "guard": "release"
    },
    {
      "id": "visual-evidence-required",
      "authority": "rules",
      "source": "RULES.md#project-agent-toolkit-rules",
      "guard": "visual"
    }
  ],
  "development_interfaces": [],
  "visual_validation": {
    "routes": [
      "visual"
    ],
    "artifact_min_count": 1,
    "min_review_checks": 1,
    "artifact_max_age_seconds": 3600,
    "require_review": true,
    "require_surface": true
  },
  "limits": {
    "entrypoint_max_lines": 120,
    "always_loaded_max_chars": 30000,
    "duplicate_paragraph_min_chars": 180
  },
  "tooling": {
    "roots": [
      ".codex"
    ],
    "allowed": [
      ".codex/config.toml",
      ".codex/agents/*.toml"
    ]
  },
  "validation": {
    "default_profiles": [
      "fast"
    ],
    "profiles": {
      "fast": {
        "commands": [
          {
            "run": "python scripts/check_plugin.py",
            "proves": "Plugin manifest, skill metadata, and templates satisfy structural invariants"
          }
        ]
      },
      "focused": {
        "extends": [
          "fast"
        ],
        "commands": [
          {
            "run": "python -m unittest discover -s tests -v",
            "proves": "Governance behavior and regression contracts pass"
          }
        ]
      },
      "release": {
        "extends": [
          "focused"
        ],
        "commands": []
      },
      "visual": {
        "extends": [
          "focused"
        ],
        "commands": []
      }
    }
  },
  "evidence": {
    "directory": ".agent-evidence"
  }
}
